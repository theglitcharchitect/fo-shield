# Path to your local Obsidian / Markdown Memory Vault
VAULT_DIR=~/MemoryVault

# Anthropic model for L2 Zero-Knowledge Brief Compilation
# (leave ANTHROPIC_API_KEY blank to run in deterministic L1-only fallback mode)
CLAUDE_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# Wajo Fo MCP Server Connection (leave FO_MCP_URL blank for instant demo simulation mode)
FO_MCP_URL=
FO_API_TOKEN=
FO_AUTO_DISPATCH=false

# Inbound Remote Agent Bridge Security (OAuth 2.1 + PKCE over Tailscale)
BRIDGE_OAUTH_SECRET=replace-with-32-byte-hex-from-openssl-rand-hex-32
